# ---- Browser-safe values ----
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
# Origin where the isolated lab apps are served (MUST differ from the app origin).
# Use a host/IP reachable from the browser: localhost for same-machine use, or
# the server's LAN IP for access from other devices (then re-run courses:sync).
NEXT_PUBLIC_LABS_ORIGIN="http://localhost:4310"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Parent origins allowed to frame the labs (comma separated). Defaults to the
# app URL; add localhost/LAN origins when both are used.
LABS_PARENT_ORIGINS="http://localhost:3000"
# Interface the dev/start servers bind to (0.0.0.0 = all interfaces)
APP_BIND_HOST="0.0.0.0"
APP_PORT="3000"
LABS_BIND_HOST="0.0.0.0"

# ---- Server-only values (never expose to the browser) ----
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
# Comma separated allowlist of lab origins accepted by the iframe bridge
LABS_ALLOWED_ORIGINS="http://localhost:4310"

# ---- Seed scripts (local development only) ----
ADMIN_EMAIL="admin@learnos.local"
ADMIN_PASSWORD="change-me-before-deploying"
ADMIN_NAME="LearnOS 管理员"
