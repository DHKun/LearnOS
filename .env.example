# ---- Browser-safe values ----
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Interface for scripts/run-next.mjs (0.0.0.0 = all interfaces)
APP_BIND_HOST="0.0.0.0"
APP_PORT="3000"

# ---- Server-only values (never expose to the browser) ----
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# ---- Docker Compose (single-host deployment) ----
# Bind address for the published 3000 port. Use 0.0.0.0 or a specific LAN/VPN IP.
LEARNOS_BIND_ADDRESS="0.0.0.0"
# Compose sets SUPABASE_INTERNAL_URL for server-side clients inside the
# container (http://host.docker.internal:54321). Do not put it here unless you
# run the container with an equivalent host-gateway mapping.

# ---- Seed scripts (local development only) ----
ADMIN_EMAIL="admin@learnos.local"
ADMIN_PASSWORD="change-me-before-deploying"
ADMIN_NAME="LearnOS 管理员"

# FloatCTF OIDC (server-only; configure the Supabase custom provider with `pnpm oidc:setup`)
FLOATCTF_OIDC_ENABLED=false
FLOATCTF_ALLOW_SIGNUP=false
FLOATCTF_OIDC_ISSUER=https://ctf.example.com
FLOATCTF_OIDC_CLIENT_ID=
FLOATCTF_OIDC_CLIENT_SECRET=

# Keycloak broker (Supabase built-in keycloak provider; server-side secret)
SUPABASE_AUTH_EXTERNAL_KEYCLOAK_SECRET=
