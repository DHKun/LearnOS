# ---- Browser-safe values ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Interface for scripts/run-next.mjs (0.0.0.0 = all interfaces)
APP_BIND_HOST="0.0.0.0"
APP_PORT="3000"

# ---- Server-only values (never expose to the browser) ----
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres"

# ---- Docker Compose (single-host deployment) ----
# Bind address for the published 3000 port. Use 0.0.0.0 or a specific LAN/VPN IP.
LEARNOS_BIND_ADDRESS="0.0.0.0"

# ---- Seed scripts (local development only) ----
ADMIN_EMAIL="admin@learnos.local"
ADMIN_PASSWORD="change-me-before-deploying"
ADMIN_NAME="LearnOS 管理员"

FLOATCTF_OIDC_ENABLED=false
FLOATCTF_ALLOW_SIGNUP=false
FLOATCTF_OIDC_ISSUER=https://ctf.example.com
FLOATCTF_OIDC_CLIENT_ID=
FLOATCTF_OIDC_CLIENT_SECRET=
# 接受其 Back-Channel Logout Token 的 FloatCTF issuer（逗号分隔）。缺省 = FLOATCTF_OIDC_ISSUER。
# 双 issuer 部署共用一个 LearnOS 数据库时，把两个 issuer 都列出（只信任这里显式列出的 issuer）。
# FLOATCTF_OIDC_TRUSTED_ISSUERS=https://ctf.example.com,https://ctf-internal.example.com:8443


# Better Auth + standalone PostgreSQL
LEARNOS_DB_URL=postgresql://learnos:learnos@127.0.0.1:5432/learnos
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3010
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3010
FLOATCTF_OIDC_ISSUER=
FLOATCTF_OIDC_CLIENT_ID=
FLOATCTF_OIDC_CLIENT_SECRET=
