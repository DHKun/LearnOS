# ---- Browser-safe values ----
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Interface for scripts/run-next.mjs (0.0.0.0 = all interfaces)
APP_BIND_HOST="0.0.0.0"
APP_PORT="3000"

# ---- Server-only values (never expose to the browser) ----
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# ---- Seed scripts (local development only) ----
ADMIN_EMAIL="admin@learnos.local"
ADMIN_PASSWORD="change-me-before-deploying"
ADMIN_NAME="LearnOS 管理员"
