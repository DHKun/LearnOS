{
  "name": "learnos",
  "version": "0.1.4",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "build": "next build",
    "start": "node scripts/run-next.mjs start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:rls": "vitest run tests/integration/rls.test.ts",
    "courses:validate": "pnpm courses:prepare && tsx scripts/courses/validate-cli.ts",
    "courses:sync": "pnpm courses:prepare && tsx scripts/courses/sync-cli.ts",
    "courses:preflight": "pnpm courses:prepare && tsx scripts/courses/preflight-cli.ts",
    "courses:snapshot": "tsx scripts/courses/snapshot-cli.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:status": "psql \"$LEARNOS_DB_URL\" -c \"select 1\"",
    "seed:admin": "tsx scripts/auth/seed-admin.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm security:scan",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose stop postgres",
    "security:scan": "tsx scripts/security-scan.ts",
    "preview": "pnpm build && node scripts/run-next.mjs start",
    "courses:prepare": "tsx scripts/courses/generate.ts",
    "predev": "pnpm courses:prepare",
    "prebuild": "pnpm courses:prepare",
    "pretypecheck": "pnpm courses:prepare",
    "courses:scan": "tsx scripts/courses/scan.ts",
    "test:unit": "vitest run tests/unit"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-tabs": "1.1.13",
    "better-auth": "^1.7.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.45.4",
    "github-slugger": "2.0.0",
    "jose": "6.2.13",
    "lucide-react": "0.545.0",
    "markdown-it": "14.1.0",
    "next": "15.5.28",
    "next-mdx-remote": "5.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "tailwind-merge": "3.3.1",
    "unified": "11.0.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@eslint/eslintrc": "3.3.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/markdown-it": "14.1.2",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "dotenv": "17.2.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.28",
    "pg": "8.16.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
