    },
    {
      "id": "h2",
      "prompt": "POST 一段合法 JSON，但 Content-Type 写成 text/plain，服务器返回 415。正确的修法是？",
      "type": "single",
      "options": [
        {
          "id": "a",
          "label": "把正文改成纯文本"
        },
        {
          "id": "b",
          "label": "把 Content-Type 改成 application/json"
        },
        {
          "id": "c",
          "label": "添加 Accept: text/plain"
        },
        {
          "id": "d",
          "label": "改用 GET"
        }
      ],
      "answer": "b",
      "explanation": "415 表示正文格式（由 Content-Type 声明）不被接受。正文本身是 JSON，标签要如实写。"
    },
    {
      "id": "h3",
      "prompt": "下面哪段是合法的 JSON？",
      "type": "single",
      "options": [
        {
          "id": "a",
          "label": "{title: \"好书\"}"
        },
        {
          "id": "b",
          "label": "{'title': '好书'}"
