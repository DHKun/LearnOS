      "id": "h1",
      "prompt": "客户端想告诉服务器「我希望收到 JSON」，应该用哪个请求头？",
      "type": "single",
      "options": [
        {
          "id": "a",
          "label": "Content-Type: application/json"
        },
        {
          "id": "b",
          "label": "Accept: application/json"
