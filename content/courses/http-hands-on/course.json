{
  "schemaVersion": 3,
  "slug": "http-hands-on",
  "title": "HTTP 实战：看懂并修好每一次请求",
  "description": "零基础的 HTTP 动手课。整门课围绕同一个模拟网站 library.test：你会读懂真实格式的请求与响应，修复失效的链接、留言、Cookie 和缓存配置，用模拟的 DevTools Network 面板排查故障，最后直接调用 API 帮读者借到一本书。所有实验都在浏览器内模拟，不访问外部网络。",
  "version": "2.0.0",
  "plugins": {
    "concepts": [
      { "id": "journey", "component": "concepts/http-concepts.tsx", "export": "JourneyConcept", "title": "按下回车之后", "analogy": "去图书馆：先找地址，再进门，最后在借阅台办事" },
      { "id": "url", "component": "concepts/http-concepts.tsx", "export": "UrlConcept", "title": "URL 的哪些部分会到达服务器", "analogy": "借阅单与夹在自己本子里的书签" },
      { "id": "message", "component": "concepts/http-concepts.tsx", "export": "MessageConcept", "title": "请求与响应逐行拆开", "analogy": "借阅单与回执" },
      { "id": "redirect", "component": "concepts/http-concepts.tsx", "export": "RedirectConcept", "title": "301 重定向", "analogy": "窗口搬家了，拿着纸条再跑一趟" },
      { "id": "retry", "component": "concepts/http-concepts.tsx", "export": "RetryConcept", "title": "重试与幂等", "analogy": "「再借一本」说两遍就是两本" },
      { "id": "negotiation", "component": "concepts/http-concepts.tsx", "export": "NegotiationConcept", "title": "Accept 与 Content-Type", "analogy": "「我要电子版」与袋子上的标签" },
      { "id": "cookie", "component": "concepts/http-concepts.tsx", "export": "CookieConcept", "title": "Cookie 与会话", "analogy": "借书证上只有一个编号" },
      { "id": "auth", "component": "concepts/http-concepts.tsx", "export": "AuthConcept", "title": "认证与授权的两道门", "analogy": "刷证进门，再看能不能进办公室" },
      { "id": "tls", "component": "concepts/http-concepts.tsx", "export": "TlsConcept", "title": "HTTPS 与网络旁观者", "analogy": "明信片与带防伪印章的保险袋" },
      { "id": "cache", "component": "concepts/http-concepts.tsx", "export": "CacheConcept", "title": "缓存的新鲜期与再验证", "analogy": "到期前直接看，过期了带着版本号去问" }
    ],
    "activities": [
      { "id": "url-lab", "component": "activities/labs.tsx", "export": "UrlLab", "title": "修好两条分享链接", "validator": { "path": "validators.ts", "export": "validateUrlLab" } },
      { "id": "request-lab", "component": "activities/labs.tsx", "export": "RequestLab", "title": "找不到的图书详情", "validator": { "path": "validators.ts", "export": "validateRequestLab" } },
      { "id": "response-lab", "component": "activities/labs.tsx", "export": "ResponseLab", "title": "读懂五份响应", "validator": { "path": "validators.ts", "export": "validateResponseLab" } },
      { "id": "method-lab", "component": "activities/labs.tsx", "export": "MethodLab", "title": "修正一个书名", "validator": { "path": "validators.ts", "export": "validateMethodLab" } },
      { "id": "json-lab", "component": "activities/labs.tsx", "export": "JsonLab", "title": "发不出去的留言", "validator": { "path": "validators.ts", "export": "validateJsonLab" } },
      { "id": "cookie-lab", "component": "activities/labs.tsx", "export": "CookieLab", "title": "会话 Cookie 的五个场景", "validator": { "path": "validators.ts", "export": "validateCookieLab" } },
      { "id": "cache-lab", "component": "activities/labs.tsx", "export": "CacheLab", "title": "两天的缓存回放", "validator": { "path": "validators.ts", "export": "validateCacheLab" } },
      { "id": "diagnosis-lab", "component": "activities/labs.tsx", "export": "DiagnosisLab", "title": "Network 面板排错", "validator": { "path": "validators.ts", "export": "validateDiagnosisLab" } },
      { "id": "final-mission", "component": "activities/labs.tsx", "export": "FinalMission", "title": "用 API 帮小林借书", "validator": { "path": "validators.ts", "export": "validateFinalMission" } }
    ]
  },
