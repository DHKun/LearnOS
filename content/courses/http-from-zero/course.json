        "title": "一次 HTTP 请求的旅程",
        "analogy": "寄信与回信：地址、信封格式和回执"
      },
      {
        "id": "url-anatomy",
        "component": "concepts/http-concepts.tsx",
        "export": "UrlAnatomy",
        "title": "URL 的五个部分",
        "analogy": "快递面单：运输方式、地址、房间号与备注"
      },
      {
        "id": "headers-cookies",
        "component": "concepts/http-concepts.tsx",
        "export": "HeadersCookies",
        "title": "Header 与 Cookie：服务器如何记住你",
        "analogy": "会员卡：第一次办卡，之后每次出示"
      }
    ],
    "activities": [
      {
