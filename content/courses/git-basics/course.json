{
  "schemaVersion": 3,
  "slug": "git-basics",
  "title": "Git 版本控制：和别人一起改代码",
  "description": "零基础的 Git 课。整门课都在 library.test 网站的代码仓库里：你是开发林可，和同事小王、陈静一起改网站。你会做出一次干净的提交、从历史里查出是谁改了借阅期限、收拾一次手忙脚乱的提交、在分支上开发、解决合并冲突、处理被拒绝的推送，最后安全地撤回一个已经上线的 bug。Git 和终端都是浏览器里的模拟环境，不执行任何真实命令。",
  "version": "1.0.0",
  "plugins": {
    "concepts": [
      {
        "id": "snapshot",
        "component": "concepts/concepts.tsx",
        "export": "SnapshotConcept",
        "title": "提交是一张张快照",
        "analogy": "照片档案"
      },
      {
        "id": "areas",
        "component": "concepts/concepts.tsx",
        "export": "AreasConcept",
        "title": "工作区、暂存区、仓库",
        "analogy": "取景框"
      },
      {
        "id": "log",
        "component": "concepts/concepts.tsx",
        "export": "LogConcept",
        "title": "说明不等于改动",
        "analogy": "照片背面的字"
      },
      {
        "id": "undo",
        "component": "concepts/concepts.tsx",
        "export": "UndoConcept",
        "title": "四种撤销",
        "analogy": "后悔药"
      },
      {
        "id": "branch",
        "component": "concepts/concepts.tsx",
        "export": "BranchConcept",
        "title": "分支是会移动的书签",
        "analogy": "书签"
      },
      {
        "id": "merge",
        "component": "concepts/concepts.tsx",
        "export": "MergeConcept",
        "title": "合并与冲突",
        "analogy": "改同一张底稿"
      },
      {
        "id": "remote",
        "component": "concepts/concepts.tsx",
        "export": "RemoteConcept",
        "title": "推送被拒绝之后",
        "analogy": "共享相册"
      },
      {
        "id": "revert",
        "component": "concepts/concepts.tsx",
        "export": "RevertConcept",
        "title": "撤销已经推送的提交",
        "analogy": "更正照片"
      }
    ],
    "activities": [
      {
        "id": "commit-lab",
        "component": "activities/labs.tsx",
        "export": "CommitLab",
